# IT 140 Module Three Assignment
# Paycheck Calculator Pseudocode Template

START paycheck_calculator

    PUT "Enter employee name:"
    GET employee_name
    
    PUT "Enter hours worked:"
    GET hours_worked
    
    PUT "Enter hourly rate:"
    GET hourly_rate
    
    PUT "Enter pre-tax deductions (or 0):"
    GET pre_tax_deductions
    
    PUT "Enter post-tax deductions (or 0):"
    GET post_tax_deductions

    IF hours_worked > 40
        LET regular_hours = 40
        LET overtime_hours = hours_worked - 40
        LET overtime_rate = hourly_rate * 1.5
        LET regular_pay = regular_hours * hourly_rate
        LET overtime_pay = overtime_hours * overtime_rate
        LET gross_pay = regular_pay + overtime_pay
    ELSE

        LET regular_hours = hours_worked
        LET overtime_hours = 0
        LET regular_pay = regular_hours * hourly_rate
        LET overtime_pay = 0
        LET gross_pay = regular_pay
    ENDIF


    LET taxable_income = gross_pay - pre_tax_deductions
    IF taxable_income < 0
        LET taxable_income = 0
    ENDIF

    LET social_security_tax = taxable_income * 0.062
    LET medicare_tax = taxable_income * 0.0145
    LET federal_tax = taxable_income * 0.12
    LET total_taxes = social_security_tax + medicare_tax + federal_tax
    LET total_deductions = total_taxes + post_tax_deductions
    
    LET net_pay = gross_pay - total_deductions
    IF net_pay < 0
        LET net_pay = 0
    ENDIF

    PUT "Paycheck summary for " + employee_name
    PUT "Gross Pay: $" + gross_pay
    PUT "Total Taxes: $" + total_taxes
    PUT "Net Take-Home Pay: $" + net_pay

END paycheck_calculator


